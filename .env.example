# --- Database ---------------------------------------------------------
# PostgreSQL connection string — e.g. from Neon (neon.tech, free tier):
# Project → Connection Details → copy the "pooled connection" string.
DATABASE_URL="postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Auth (Auth.js / NextAuth v5) --------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Bootstrap admin --------------------------------------------------------
# No demo accounts ship with this app. Set these to your OWN real email and a
# strong password — the first admin account is created automatically from
# these (on `npm run db:seed` or on first visit to /admin/login), and never
# again once any admin exists. Create further admins from the dashboard.
INITIAL_ADMIN_EMAIL="you@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-password"
INITIAL_ADMIN_NAME="Admin"

# --- Termii (SMS OTP for phone verification) --------------------------------
# Optional — from termii.com. Without it, registration OTP codes are logged
# server-side and returned in the API response as dev-mode instead of texted,
# so the flow stays testable, but no real user can receive a code until this
# is set. Configure before real launch.
TERMII_API_KEY="replace_me"
TERMII_SENDER_ID="N-Alert"

# --- Paystack -----------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Flutterwave ----------------------------------------------------------
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_WEBHOOK_SECRET_HASH="replace-with-a-random-string-set-in-flw-dashboard"

# --- Google Maps (delivery distance pricing) -------------------------------
# Optional — without it, delivery falls back to a flat fee. Needs the
# Geocoding API and Distance Matrix API enabled in Google Cloud Console.
GOOGLE_MAPS_API_KEY="replace_me"

# --- Vercel Blob (admin product photo uploads) -----------------------------
# Optional — without it, the admin "Add photo" button shows an error.
# Vercel Storage tab → create a Blob store → linked projects get this
# injected automatically; for local dev, copy the token here.
BLOB_READ_WRITE_TOKEN="replace_me"

# --- Misc -----------------------------------------------------------------
# Optional — payment callback URLs fall back to the request's own origin if
# this is unset, so it's safe to leave blank on first deploy. Set it once you
# know your final domain (Vercel URL or custom domain) for stability.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
