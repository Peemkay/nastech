# --- Database ---------------------------------------------------------
# Dev default: local SQLite file, zero install required.
# For production, switch prisma/schema.prisma provider to "postgresql" and
# point this at a real Postgres instance (e.g. Neon, Supabase, RDS).
DATABASE_URL="file:./dev.db"

# --- Auth (Auth.js / NextAuth v5) --------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Paystack -----------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Flutterwave ----------------------------------------------------------
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X"
FLUTTERWAVE_WEBHOOK_SECRET_HASH="replace-with-a-random-string-set-in-flw-dashboard"

# --- Misc -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
