// NASTECH Gadgets — data model
//
// PostgreSQL (e.g. Neon, Supabase, RDS) — required for any real deployment,
// since serverless hosts (Vercel etc.) have no persistent disk for SQLite.
// The model still avoids native enums/Decimal/scalar arrays (plain
// String/Int/Json instead) purely to keep migrations simple and portable —
// not a SQLite requirement anymore, just a nice constraint to keep.
// Money is stored as Int in kobo (₦1 = 100 kobo) to avoid float rounding.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CUSTOMER") // CUSTOMER | ADMIN | SUPERADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  sellRequests   SellRequest[]
  orders         Order[]
  reviews        Review[]
  repairRequests RepairRequest[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home") // Home | Office | Other
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String // Nigerian state
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Device catalog / quote engine ----------

model DeviceCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String   @default("smartphone")
  sortOrder Int      @default(0)

  brands            Brand[]
  conditionQuestions ConditionQuestion[]
  products          Product[]
  sellRequests      SellRequest[]
  repairIssues      RepairIssue[]
  repairRequests    RepairRequest[]
}

model Brand {
  id         String   @id @default(cuid())
  categoryId String
  category   DeviceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  logoUrl    String?

  models         DeviceModel[]
  products       Product[]
  repairRequests RepairRequest[]

  @@unique([categoryId, slug])
}

model DeviceModel {
  id              String   @id @default(cuid())
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  image           String?
  releaseYear     Int?
  baseValueKobo   Int // best-condition, top-storage trade-in value
  storageOptions  Json // e.g. ["64GB","128GB","256GB"] — always supplied by application code

  sellRequests SellRequest[]
  products     Product[]

  @@unique([brandId, slug])
}

model ConditionQuestion {
  id         String   @id @default(cuid())
  categoryId String
  category   DeviceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question   String
  sortOrder  Int      @default(0)

  options ConditionOption[]
}

model ConditionOption {
  id             String   @id @default(cuid())
  questionId     String
  question       ConditionQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label          String
  deductionBps   Int      @default(0) // deduction in basis points (1/100 of a percent) of base value
  sortOrder      Int      @default(0)
}

// ---------- Sell / trade-in ----------

model SellRequest {
  id         String   @id @default(cuid())
  code       String   @unique // NAS-SEL-000123

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  categoryId String
  category   DeviceCategory @relation(fields: [categoryId], references: [id])
  modelId    String
  model      DeviceModel    @relation(fields: [modelId], references: [id])
  storage    String?

  answers        Json // questionId -> optionId — always supplied by application code
  quotedKobo     Int
  finalKobo      Int?

  status String @default("QUOTE_GENERATED")
  // QUOTE_GENERATED | PICKUP_SCHEDULED | PICKED_UP | INSPECTING |
  // OFFER_REVISED | ACCEPTED | REJECTED_BY_CUSTOMER | PAID_OUT | CANCELLED

  contactName  String
  contactPhone String
  contactEmail String

  pickupLine1  String?
  pickupLine2  String?
  pickupCity   String?
  pickupLga    String?
  pickupState  String?
  pickupDate   DateTime?
  pickupSlot   String?

  payoutBankName      String?
  payoutAccountNumber String?
  payoutAccountName   String?

  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents SellRequestStatusEvent[]
}

model SellRequestStatusEvent {
  id            String      @id @default(cuid())
  sellRequestId String
  sellRequest   SellRequest @relation(fields: [sellRequestId], references: [id], onDelete: Cascade)
  status        String
  note          String?
  createdAt     DateTime    @default(now())
}

// ---------- Refurbished store ----------

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  slug            String   @unique
  categoryId      String
  category        DeviceCategory @relation(fields: [categoryId], references: [id])
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id])
  modelId         String?
  model           DeviceModel? @relation(fields: [modelId], references: [id])

  grade           String   @default("GOOD") // LIKE_NEW | GOOD | FAIR
  storage         String?
  color           String?

  priceKobo          Int
  compareAtPriceKobo Int?
  stock              Int    @default(0)

  images      Json // always supplied by application code
  description String  @default("")
  specs       Json // always supplied by application code

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  reviews    Review[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

// ---------- Orders / payments ----------

model Order {
  id     String @id @default(cuid())
  code   String @unique // NAS-ORD-000123

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  subtotalKobo    Int
  shippingFeeKobo Int    @default(0)
  deliveryDistanceKm Float? // road distance from depot at time of order, if computed via the distance API
  totalKobo       Int
  currency        String @default("NGN")

  status String @default("PENDING_PAYMENT")
  // PENDING_PAYMENT | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED

  paymentMethod String? // PAYSTACK | FLUTTERWAVE | BANK_TRANSFER
  paymentStatus String  @default("PENDING")
  // PENDING | AWAITING_VERIFICATION | PAID | FAILED | REFUNDED

  contactEmail String
  contactPhone String

  shipFullName String
  shipPhone    String
  shipLine1    String
  shipLine2    String?
  shipCity     String
  shipLga      String?
  shipState    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        OrderItem[]
  payments     Payment[]
  statusEvents OrderStatusEvent[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  image     String?
  priceKobo Int
  quantity  Int
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model Payment {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String // PAYSTACK | FLUTTERWAVE | BANK_TRANSFER
  reference  String   @unique
  amountKobo Int
  currency   String   @default("NGN")
  status     String   @default("INITIATED") // INITIATED | SUCCESS | FAILED
  rawPayload Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WebhookLog {
  id         String   @id @default(cuid())
  provider   String // PAYSTACK | FLUTTERWAVE
  eventType  String?
  reference  String?
  payload    Json
  verified   Boolean  @default(false)
  processed  Boolean  @default(false)
  receivedAt DateTime @default(now())
}

// ---------- Settings (singleton) ----------

model Settings {
  id                     String  @id @default("singleton")
  siteName               String  @default("NASTECH Gadgets")
  supportPhone           String  @default("+234 800 000 0000")
  supportEmail           String  @default("support@nastech.ng")
  activeGateways         Json // always supplied by application code — see lib/settings.ts getSettings()
  defaultGateway         String  @default("PAYSTACK")
  bankName               String  @default("NASTECH Gadgets Ltd — Providus Bank")
  bankAccountNumber      String  @default("0000000000")
  bankAccountName        String  @default("NASTECH Gadgets Limited")
  freeShippingThresholdKobo Int  @default(5000000)

  // --- Delivery pricing (distance-based, from the depot) ---
  depotName        String @default("NASTECH Hub — Dutsen Alhaji Market")
  depotAddress     String @default("Dutsen Alhaji Market, Bwari Area Council, Abuja, FCT")
  depotLat         Float  @default(9.0667)
  depotLng         Float  @default(7.4833)
  baseFareKobo     Int    @default(100000) // ₦1,000 — flat fee included before per-km charge
  perKmFareKobo    Int    @default(15000)  // ₦150 / km beyond the base
  minFareKobo      Int    @default(150000) // ₦1,500 — floor, in case computed fare undercuts it
  maxDeliveryKm    Int    @default(60)     // beyond this, delivery isn't offered (customer contacted manually)

  updatedAt DateTime @updatedAt
}

// ---------- Service regions (which Nigerian states are live) ----------

model ServiceRegion {
  id        String   @id @default(cuid())
  state     String   @unique // must match a name from the states API, e.g. "FCT", "Lagos"
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ---------- Repair services ----------

model RepairIssue {
  id            String   @id @default(cuid())
  categoryId    String
  category      DeviceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String // e.g. "Screen Replacement"
  type          String   @default("HARDWARE") // HARDWARE | SOFTWARE
  basePriceKobo Int // starting/estimate price — "from ₦X", final cost confirmed after diagnosis
  durationHint  String   @default("1-2 hours") // free text, e.g. "Same day", "24-48 hours"
  description   String   @default("")
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)

  requestLines RepairRequestIssue[]
}

model RepairRequest {
  id         String   @id @default(cuid())
  code       String   @unique // NAS-REP-000123

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  categoryId String
  category   DeviceCategory @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?   @relation(fields: [brandId], references: [id])
  deviceLabel String // free text, e.g. "iPhone 12 Pro, black" — brand/model may not be in our catalog

  problemDescription String @default("")

  serviceType String // DROP_OFF | PICKUP
  contactName  String
  contactPhone String
  contactEmail String

  pickupLine1  String?
  pickupLine2  String?
  pickupCity   String?
  pickupLga    String?
  pickupState  String?
  pickupDate   DateTime?
  pickupSlot   String?

  estimatedKobo Int
  finalKobo     Int?
  paymentStatus String @default("PENDING") // PENDING | PAID

  status String @default("REQUESTED")
  // REQUESTED | DIAGNOSING | AWAITING_APPROVAL | IN_REPAIR | READY | COMPLETED | CANCELLED

  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues       RepairRequestIssue[]
  statusEvents RepairStatusEvent[]
}

model RepairRequestIssue {
  id              String        @id @default(cuid())
  repairRequestId String
  repairRequest   RepairRequest @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  repairIssueId   String
  repairIssue     RepairIssue   @relation(fields: [repairIssueId], references: [id])
  name            String // snapshot, in case the catalog entry changes later
  priceKobo       Int // snapshot
}

model RepairStatusEvent {
  id              String        @id @default(cuid())
  repairRequestId String
  repairRequest   RepairRequest @relation(fields: [repairRequestId], references: [id], onDelete: Cascade)
  status          String
  note            String?
  createdAt       DateTime      @default(now())
}
